{
    "name": "snuboard-server",
    "version": "0.0.1",
    "description": "",
    "author": "",
    "private": true,
    "license": "UNLICENSED",
    "scripts": {
        "prebuild": "npx rimraf dist",
        "build": "npx nest build",
        "format": "npx prettier --write \"src/**/*.ts\" \"test/**/*.ts\"",
        "start": "npx nest start",
        "start:dev": "npx nest start --watch",
        "start:debug": "npx nest start --debug --watch",
        "start:prod": "node dist/main",
        "lint": "npx eslint \"{src,apps,libs,test}/**/*.ts\" --fix",
        "test": "npx jest",
        "test:watch": "npx jest --watch",
        "test:cov": "npx jest --coverage",
        "test:debug": "node --inspect-brk -r tsconfig-paths/register -r ts-node/register node_modules/.bin/jest --runInBand",
        "test:e2e": "npx jest --config ./test/jest-e2e.json",
        "typeorm": "npx node --require ./node_modules/ts-node/register ./node_modules/typeorm/cli.js -d dist/datasource.js",
        "prepare": "npx husky"
    },
    "dependencies": {
        "@nestjs/cli": "^10.4.5",
        "@nestjs/common": "^10.4.4",
        "@nestjs/config": "^3.2.3",
        "@nestjs/core": "^10.4.4",
        "@nestjs/jwt": "^10.2.0",
        "@nestjs/passport": "^10.0.3",
        "@nestjs/platform-express": "^10.4.4",
        "@nestjs/typeorm": "^10.0.2",
        "bcrypt": "^5.1.1",
        "class-transformer": "^0.5.1",
        "class-validator": "^0.14.1",
        "express": "^4.21.0",
        "firebase-admin": "^12.5.0",
        "mysql2": "^3.11.3",
        "nestjs": "^0.0.1",
        "passport-jwt": "^4.0.1",
        "sqlite3": "^5.1.7",
        "typeorm": "^0.3.20"
    },
    "devDependencies": {
        "@apify/eslint-config": "^0.4.0",
        "@eslint/eslintrc": "^3.1.0",
        "@eslint/js": "^9.11.1",
        "@nestjs/testing": "^10.4.4",
        "@types/bcrypt": "^5.0.2",
        "@types/bluebird": "^3.5.42",
        "@types/express": "^5.0.0",
        "@types/jest": "^29.5.13",
        "@types/jsdom": "^21.1.7",
        "@types/passport-jwt": "^4.0.1",
        "@typescript-eslint/eslint-plugin": "^8.7.0",
        "eslint-config-prettier": "^9.1.0",
        "eslint-plugin-import": "^2.30.0",
        "eslint-plugin-prettier": "^5.2.1",
        "globals": "^15.9.0",
        "husky": "^9.1.6",
        "jest": "^29.7.0",
        "prettier": "^3.3.3",
        "ts-jest": "^29.2.5",
        "ts-node": "^10.9.2",
        "typescript": "~5.5.4"
    },
    "jest": {
        "moduleFileExtensions": [
            "js",
            "json",
            "ts"
        ],
        "rootDir": "src",
        "testRegex": ".*\\.spec\\.ts$",
        "transform": {
            "^.+\\.(t|j)s$": "ts-jest"
        },
        "collectCoverageFrom": [
            "**/*.(t|j)s"
        ],
        "coverageDirectory": "../coverage",
        "testEnvironment": "node"
    },
    "husky": {
        "hooks": {
            "pre-commit": "lint-staged"
        }
    },
    "lint-staged": {
        "src/**/*.{js,json,ts}": [
            "npx prettier --write"
        ]
    }
}
